# Variables de entorno — Plataforma de ventas SG Querétaro
#
# Copia este archivo a `.env.local` para desarrollo y llena los valores reales
# ahí (NUNCA en este archivo, NUNCA en el repositorio). En producción, estas
# mismas variables se configuran en el panel de Vercel.
#
# `src/server/config/env.ts` valida todas las variables requeridas con Zod al
# arrancar la aplicación: si falta una, el servidor no levanta y dice cuál.
#
# Regla del prefijo: `NEXT_PUBLIC_` significa "esto viaja al navegador y
# cualquiera puede leerlo". Las variables sin ese prefijo son secretas y
# viven solo en el servidor. Ver `.devsquad/arquitectura.md` §10 para el
# detalle completo de cada una.

# ── Base y Supabase ──────────────────────────────────────────────────────
# URL base del sitio; construye los enlaces de los correos transaccionales.
NEXT_PUBLIC_SITE_URL=

# Dirección del proyecto Supabase. No es secreta.
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública del cliente de Supabase; su seguridad la da RLS. No es secreta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA — CRÍTICA. Llave con privilegios que salta RLS. Solo se usa en
# src/server/supabase/admin.ts, para cambios de estado de pedido, stock,
# bitácoras y tareas programadas. Nunca debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SECRETA. Conexión directa a Postgres para correr migraciones con la
# Supabase CLI. Solo hace falta en desarrollo local / CI.
SUPABASE_DB_URL=

# ── Cloudflare R2 (archivos: fotos de producto y comprobantes de pago) ───
# Identificador de la cuenta de Cloudflare. No es secreta, pero no se publica.
R2_ACCOUNT_ID=

# SECRETA. Usuario de acceso a los buckets de R2.
R2_ACCESS_KEY_ID=

# SECRETA — CRÍTICA. Contraseña de acceso a los buckets de R2.
R2_SECRET_ACCESS_KEY=

# Nombre del bucket público (fotos y documentos de producto, banners).
R2_BUCKET_PUBLIC=

# Nombre del bucket privado (comprobantes de pago, fotos de devolución).
R2_BUCKET_PRIVATE=

# Dominio del CDN de imágenes (https://cdn.<dominio>). No es secreta.
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Correo transaccional (Resend) ─────────────────────────────────────────
# SECRETA. Llave de la API de Resend para enviar correos transaccionales.
RESEND_API_KEY=

# Remitente verificado (ej. pedidos@tudominio.com). No es secreta.
EMAIL_FROM=

# Correo al que responde el cliente. No es secreta.
EMAIL_REPLY_TO=

# ── WhatsApp (opcional; hasta entonces "none") ─────────────────────────────
# "none" | "meta" | "twilio". Con "none" el canal simplemente no se registra
# y las notificaciones solo salen por correo (ver src/server/notifications).
WHATSAPP_PROVIDER=none

# ── Solo si WHATSAPP_PROVIDER=meta (Meta Cloud API directo) ───────────────
# Identificador del número emisor en Meta Cloud API. No es secreta.
WHATSAPP_PHONE_NUMBER_ID=

# SECRETA — CRÍTICA. Credencial de envío de WhatsApp (Meta).
WHATSAPP_ACCESS_TOKEN=

# Nombre de la plantilla aprobada por Meta para el aviso de comprobante.
WHATSAPP_TEMPLATE_NAME=

# ── Solo si WHATSAPP_PROVIDER=twilio ───────────────────────────────────────
# Se encuentran en el Twilio Console → Account → API keys & tokens.
# El SID de la cuenta (empieza con "AC..."). No es secreta.
TWILIO_ACCOUNT_SID=

# SECRETA — CRÍTICA. El Auth Token de la cuenta de Twilio.
TWILIO_AUTH_TOKEN=

# Número emisor con el prefijo "whatsapp:" y formato E.164, ej.
# "whatsapp:+14155238886" (el número compartido del Sandbox de Twilio,
# mientras no se tenga un número de WhatsApp Business propio). No es secreta.
TWILIO_WHATSAPP_FROM=

# ── Seguridad y operación ─────────────────────────────────────────────────
# SECRETA — CRÍTICA. Sal secreta para hashear (SHA-256 + pepper) los tokens
# de confirmación de pago por correo. Mínimo 16 caracteres, aleatoria.
PAYMENT_TOKEN_PEPPER=

# SECRETA. Autentica las llamadas a /api/cron/*; sin esto cualquiera podría
# dispararlas. Mínimo 16 caracteres, aleatoria.
CRON_SECRET=

# Llave pública del widget anti-spam Cloudflare Turnstile. No es secreta.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SECRETA. Verificación del widget de Turnstile del lado del servidor.
TURNSTILE_SECRET_KEY=

# Expiración de la sesión administrativa, en minutos (más corta que la del
# cliente, criterio H2). No es secreta. Sugerido: 120.
ADMIN_SESSION_MAX_AGE_MINUTES=120

# Días para cancelar automáticamente un pedido sin comprobante (decisión de
# la dueña del proyecto, 2026-09-20). No es secreta.
ORDER_AUTO_CANCEL_DAYS=3

# Plazo en días para solicitar una devolución (decisión de la dueña del
# proyecto, 2026-09-20). No es secreta.
RETURN_WINDOW_DAYS=30
